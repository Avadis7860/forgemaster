---
// Startseite DE (Präfix /de/). Gleiche Komposition wie EN, gefiltert auf die Locale DE.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Brouillons (`draft: true`) filtrés en PROD, visibles en dev — le contenu inachevé ne se publie jamais.
const entries = (
  await getCollection(
    'sections',
    ({ data }) => data.locale === 'de' && (import.meta.env.PROD ? !data.draft : true),
  )
).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="Site vitrine" description="Eine Platzhalter-Vitrinen-Website, bereitgestellt vom cockpit.">
  {
    rendered.map(({ entry, Content }, i) => (
      <section>
        {i === 0 ? <h1>{entry.data.title}</h1> : <h2>{entry.data.title}</h2>}
        <Content />
      </section>
    ))
  }
</BaseLayout>
