---
// Page d'accueil FR (préfixe /fr/). Même composition que EN, filtrée sur la locale FR.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('sections', ({ data }) => data.locale === 'fr')).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="Site vitrine" description="Un site vitrine d'exemple semé par le cockpit.">
  {
    rendered.map(({ entry, Content }, i) => (
      <section>
        {i === 0 ? <h1>{entry.data.title}</h1> : <h2>{entry.data.title}</h2>}
        <Content />
      </section>
    ))
  }
</BaseLayout>
