# .dockerignore — garde hors du contexte de build ce qui n'est PAS l'app runtime (semé par le cockpit,
# deploy chain) : outillage IA, docs, cartes, méta git, dépendances/artefacts installés. node_modules et
# dist sont (re)construits DANS l'image (npm ci && npm run build) — jamais copiés depuis l'hôte.
.git
.gitignore
.dockerignore
.claude
.cockpit
docs
CLAUDE.md
.docsmap.toml
.codemap.toml
.frontmap.toml
compose.yaml
Dockerfile
node_modules
dist
