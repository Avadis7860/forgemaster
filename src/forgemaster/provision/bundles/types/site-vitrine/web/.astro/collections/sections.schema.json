{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "fr",
        "de"
      ]
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "locale"
  ]
}