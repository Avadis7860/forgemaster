{
  "name": "site-vitrine-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Site vitrine (Astro SSG, i18n EN/FR/DE) semé par le forgemaster. Le script `gate` monte la toolchain composite (astro check → tsc → vitest → astro build).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "gate": "astro check && tsc --noEmit && vitest run && astro build"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.1.6",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
