---
// Ornament — primitives décoratives (woaw P4) : `corner`, `separator`, `sparkle`. SVG inline, `aria-hidden`,
// héritent `currentColor` (thémé par l'instance). Signent la page sans bruit — l'accent, pas le tapis. Le
// worker les pose aux sections porteuses ; une même famille réutilisée = cohérence.
interface Props {
  kind: 'corner' | 'separator' | 'sparkle';
  class?: string;
}
const { kind, class: extra = '' }: Props = Astro.props;
---

{
  kind === 'corner' && (
    <svg
      class:list={['ornament', extra]}
      width="48"
      height="48"
      viewBox="0 0 48 48"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M2 46V14a12 12 0 0 1 12-12h32"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <circle cx="6" cy="42" r="2.5" fill="currentColor" />
    </svg>
  )
}

{
  kind === 'separator' && (
    <svg
      class:list={['ornament', 'ornament-sep', extra]}
      width="220"
      height="16"
      viewBox="0 0 220 16"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      <path d="M0 8h92" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
      <path d="M128 8h92" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
      <path d="M110 2l5 6-5 6-5-6z" fill="currentColor" />
    </svg>
  )
}

{
  kind === 'sparkle' && (
    <svg
      class:list={['ornament', extra]}
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path d="M12 1l1.8 7.2L21 10l-7.2 1.8L12 19l-1.8-7.2L3 10l7.2-1.8z" fill="currentColor" />
    </svg>
  )
}

<style>
  .ornament {
    display: inline-block;
    color: inherit;
  }
  .ornament-sep {
    width: 100%;
    max-width: 220px;
    height: auto;
  }
</style>
