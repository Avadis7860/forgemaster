---
// Surface — enveloppe de relief (woaw P2/P6) : `raised` (décollée, ombrée), `sunken` (creusée), `plain`.
// Donne au tissu ses REGISTRES de profondeur au lieu de la grille de cartes iso-bordées (lazy default). Le
// worker alterne les registres pour créer le relief ; les ombres viennent des tokens (`--shadow-*`), pas d'un
// CSS dispersé.
interface Props {
  variant?: 'raised' | 'sunken' | 'plain';
  // `li`/`figure` : une LISTE de surfaces veut des `li`, un bloc légendé un `figure` — l'ergonomie que la
  // page-référence a réclamée pour composer du tissu sans casser la structure du document.
  as?: 'div' | 'section' | 'article' | 'aside' | 'li' | 'figure';
  class?: string;
}
const { variant = 'plain', as: Tag = 'div', class: extra = '' }: Props = Astro.props;
---

<Tag class:list={['surface', `surface-${variant}`, extra]}><slot /></Tag>

<style>
  .surface {
    /* `relative` : un registre porte souvent un décor absolu (ornement, halo) posé DANS son cadre. */
    position: relative;
    border-radius: var(--radius-card);
  }
  .surface-raised {
    background: var(--color-surface);
    box-shadow: var(--shadow-raised);
  }
  /* Sunken : le registre plus foncé, PRESSÉ vers l'intérieur par l'ombre insérée. Sans le `box-shadow` il
     lirait comme un simple aplat teinté ; c'est l'inset qui le fait lire comme creusé (le 2ᵉ plan de P6). */
  .surface-sunken {
    background: var(--color-surface-sunken);
    box-shadow: var(--shadow-sunken);
  }
  .surface-plain {
    background: transparent;
  }
</style>
