# ============================================================
# Python (daemon + CLI)
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ============================================================
# Node / frontend (Vite + React)
# ============================================================
node_modules/
web/dist/
dist/
.vite/
*.log
# tampon de provenance de build (écrit par deploy/build-wheel.sh, embarqué au wheel via force_include) —
# artefact PAR-BUILD, jamais committé. Ancré (`/`) : ne matche que le fichier de tête, pas ailleurs.
/src/cockpit/_build.json

# ============================================================
# État local / données runtime (NE PAS versionner)
# ============================================================
# NB : patterns ANCRÉS à la racine (`/`) — un `projects/` nu matcherait AUSSI le package source
# `src/cockpit/projects/` (footgun gitignore : motif non ancré = match à toute profondeur).
*.sqlite3
*.sqlite3-journal
/data/
/worktrees/
/projects/

# ============================================================
# Index docs-map (<repo>/.docsmap/) — carte de doc dérivée, bâtie au setup, jamais versionnée
# ============================================================
.docsmap/

# ============================================================
# Env / secrets
# ============================================================
.env
.env.*
!.env.example
*.local

# ============================================================
# Éditeurs / OS
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# index code-map local (cache dérivé, reconstructible — jamais suivi)
.codemap/

# index front-map local (cache dérivé per-racine, reconstructible — jamais suivi)
.frontmap/
